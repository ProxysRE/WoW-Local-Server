[worldserver]

# Maximum equipment content stage. Earlier sources remain available.
# -1 = disabled (original Playerbots behavior).
#  0 = Classic dungeons, Molten Core, Onyxia
#  1 = Blackwing Lair; 3 = Zul'Gurub; 5 = AQ20/AQ40; 6 = Naxxramas 40
#  8 = TBC dungeons/heroics, Karazhan, Gruul, Magtheridon, arena S1
#  9 = SSC, Tempest Keep, arena S2
# 10 = Hyjal, Black Temple, arena S3
# 11 = Zul'Aman and its badge rewards
# 12 = Sunwell, Magisters' Terrace, Sunwell badge rewards, arena S4
# 13 = Wrath dungeons, Naxxramas, Obsidian Sanctum, Eye of Eternity, arena S5
# 14 = Ulduar, arena S6
# 15 = ToC, ToC5, Onyxia 80, arena S7
# 16 = ICC, ICC5, arena S8
# 17 = Ruby Sanctum
# Intermediate IP values 2/4/7 have the same gear availability as 1/3/6.
# This setting does not change any character's Individual Progression stage.
BotGearProgression.Stage = 8

# One complete equipment reroll per random bot, per worldserver process.
# Existing friends of real players and members of player-led guilds are exempt.
BotGearProgression.RerollOnStartup = 1

# Spread equipment work over time; one bot per this many milliseconds.
BotGearProgression.RerollIntervalMs = 200

# Optional exact item corrections: itemID:minimumStage, separated by commas.
# Stage 99 explicitly bans an item while the module is enabled.
# Example: "28770:8,32471:10". Unknown items are otherwise not generated.
BotGearProgression.ItemOverrides = ""

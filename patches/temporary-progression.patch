+    static bool TemporarySwitchAllowed(ChatHandler* handler)
+    {
+        Player* player = handler->GetPlayer();
+        if (!sIndividualProgression->enabled || !player || !player->IsInWorld())
+        {
+            handler->SendSysMessage("Individual Progression must be enabled.");
+            return false;
+        }
+        if (!player->IsAlive() || player->IsInCombat() || player->IsInFlight() ||
+            player->IsBeingTeleported() || player->InBattleground() ||
+            player->GetMap()->IsDungeon())
+        {
+            handler->SendSysMessage("Change temporary progression while alive, out of combat, on the open-world ground.");
+            return false;
+        }
+        return true;
+    }
+
+    static bool HandleTemporaryStatus(ChatHandler* handler)
+    {
+        Player* player = handler->GetPlayer();
+        handler->PSendSysMessage("Temporary progression: {}. Effective stage: {}. Saved stage: {}. Use .ip temp <0-18 except 11> or .ip temp off.",
+            sIndividualProgression->HasTemporaryProgression(player) ? "on" : "off",
+            sIndividualProgression->GetPlayerProgressionFromQuests(player),
+            sIndividualProgression->GetStoredProgression(player));
+        return true;
+    }
+
+    static bool HandleTemporaryStart(ChatHandler* handler, Optional<uint32> stage)
+    {
+        if (!stage)
+            return HandleTemporaryStatus(handler);
+        if (!TemporarySwitchAllowed(handler))
+            return false;
+        Player* player = handler->GetPlayer();
+        if (!sIndividualProgression->isNormalAccount(player))
+        {
+            handler->SendSysMessage("Temporary visits require a normal player account, not a bot/excluded account.");
+            return false;
+        }
+        if (sIndividualProgression->progressionLimit && *stage > uint32(sIndividualProgression->progressionLimit))
+        {
+            handler->SendSysMessage("This stage exceeds the server ProgressionLimit.");
+            return false;
+        }
+        if (!sIndividualProgression->SetTemporaryProgression(player, *stage))
+        {
+            handler->SendSysMessage("Invalid stage: use 0-18 except 11, no higher than your saved stage.");
+            return false;
+        }
+        HandleTemporaryStatus(handler);
+        handler->SendSysMessage("Saved progression is unchanged. The visit ends on logout. Disable GM mode to see normal event phasing.");
+        return true;
+    }
+
+    static bool HandleTemporaryOff(ChatHandler* handler)
+    {
+        // Always allow restoration even if IP was disabled by a config reload.
+        Player* player = handler->GetPlayer();
+        if (player->IsInCombat() || player->IsInFlight() || player->IsBeingTeleported() || player->GetMap()->IsDungeon())
+        {
+            handler->SendSysMessage("Leave combat, taxi flight and instances before restoring the timeline, or log out.");
+            return false;
+        }
+        sIndividualProgression->ClearTemporaryProgression(player);
+        return HandleTemporaryStatus(handler);
+    }

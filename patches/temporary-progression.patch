+bool IndividualProgression::HasTemporaryProgression(Player const* player)
+{
+    auto const* state = player ? player->CustomData.Get<TemporaryState>(TemporaryKey) : nullptr;
+    return state && state->selection.Active();
+}
+
 uint8 IndividualProgression::GetPlayerProgressionFromQuests(Player* player) const
+{
+    if (!player || !player->IsInWorld())
+        return 0;
+    uint8 stored = GetStoredProgression(player);
+    auto const* state = player ? player->CustomData.Get<TemporaryState>(TemporaryKey) : nullptr;
+    return state ? state->selection.Effective(stored) : stored;
+}
+
+bool IndividualProgression::SetTemporaryProgression(Player* player, uint32 stage)
+{
+    if (!enabled || !player || !player->IsInWorld())
+        return false;
+    auto* state = player->CustomData.GetDefault<TemporaryState>(TemporaryKey);
+    if (!state->selection.Select(stage, GetStoredProgression(player)))
+        return false;
+    auto* view = player->CustomData.GetDefault<TemporaryQuestRewards>(TemporaryQuestRewards::Key);
+    view->first = 66000 + PROGRESSION_MOLTEN_CORE;
+    view->last = 66000 + PROGRESSION_WOTLK_TIER_5;
+    view->completedThrough = 66000 + stage;
+    RefreshTemporaryProgression(player);
+    return true;
+}
+
+void IndividualProgression::ClearTemporaryProgression(Player* player)
+{
+    if (!player)
+        return;
+    player->CustomData.Erase(TemporaryKey);
+    player->CustomData.Erase(TemporaryQuestRewards::Key);
+    RefreshTemporaryProgression(player);
+}
+
+void IndividualProgression::RefreshTemporaryProgression(Player* player)
+{
+    if (!player || !player->IsInWorld())
+        return;
+    // Even with IP disabled, clear a phase saved during an interrupted visit.
+    checkIPPhasing(player, enabled ? player->GetAreaId() : 0);
+    CheckAdjustments(player);
+    player->UpdateObjectVisibility();
+}

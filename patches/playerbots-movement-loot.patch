+bool PlayerbotAI::UpdateTaxiFlight()
+{
+    MotionMaster* motion = bot->GetMotionMaster();
+    bool const hasFlightMovement = motion->GetCurrentMovementGeneratorType() == FLIGHT_MOTION_TYPE;
+    if (!bot->IsInFlight() && !hasFlightMovement)
+    {
+        _taxiSplineStoppedAt = 0;
+        return false;
+    }
+
+    if (auto* travel = std::get_if<NewRpgInfo::TravelFlight>(&rpgInfo.data))
+        travel->inFlight = true;
+
+    if (IsSelfBot(bot) || !hasFlightMovement || !bot->movespline->Finalized())
+    {
+        _taxiSplineStoppedAt = 0;
+        return true;
+    }
+
+    auto* flight = static_cast<FlightPathMovementGenerator*>(motion->top());
+    auto const& path = flight->GetPath();
+    uint32 const currentNode = flight->GetCurrentNode();
+    if (currentNode >= path.size())
+        return true;
+
+    // Bots have no client to acknowledge the spline's map boundary.
+    uint32 const mapEnd = flight->GetPathAtMapEnd();
+    if (mapEnd < path.size() && currentNode + 1 >= mapEnd && path[mapEnd]->mapid != bot->GetMapId())
+    {
+        TaxiPathNodeEntry const* node = path[mapEnd];
+        flight->SetCurrentNodeAfterTeleport();
+        flight->SkipCurrentNode();
+        _taxiSplineStoppedAt = 0;
+        bot->TeleportTo(node->mapid, node->x, node->y, node->z, bot->GetOrientation(), TELE_TO_NOT_LEAVE_TAXI);
+        return true;
+    }
+
+    // A normal landing finalizes on the next movement update. Only restart a
+    // terminated spline after a grace period, keeping the original path and fare.
+    constexpr uint32 taxiRecoveryDelay = 10 * IN_MILLISECONDS;
+    if (!_taxiSplineStoppedAt)
+        _taxiSplineStoppedAt = getMSTime();
+    else if (GetMSTimeDiffToNow(_taxiSplineStoppedAt) >= taxiRecoveryDelay)
+    {
+        LOG_WARN("playerbots", "Taxi spline recovery: bot {} map {} path node {}/{}", bot->GetName(), bot->GetMapId(),
+                 currentNode, path.size());
+        _taxiSplineStoppedAt = 0;
+        flight->Reset(bot);
+    }
+    return true;
+}
